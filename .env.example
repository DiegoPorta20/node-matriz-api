# Copia este archivo a .env para ejecutar en local: cp .env.example .env
#
# node-api si carga el .env al arrancar, buscandolo en su raiz y en la del proyecto padre.

# Opcional, 3000 por defecto.
NODE_API_PORT=3000

# Obligatoria, 32 caracteres como minimo. Tiene que ser la misma que la de go-api: node-api
# no emite tokens, solo valida los que go-api firma.
JWT_SECRET=12345678901234567890123456789012

# Opcional, info por defecto.
LOG_LEVEL=info
